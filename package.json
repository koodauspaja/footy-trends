{
  "name": "footy-trends",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "admin:role": "tsx scripts/grant-admin.ts",
    "backfill": "tsx scripts/backfill.ts",
    "build": "next build",
    "db:generate": "tsx scripts/generate-migration.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:reset:dev": "tsx scripts/db-reset.ts --dev",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbopack",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "predb:migrate": "tsx scripts/ensure-services.ts",
    "predb:push": "tsx scripts/ensure-services.ts",
    "predb:studio": "tsx scripts/ensure-services.ts",
    "predev": "tsx scripts/ensure-services.ts",
    "prepare": "husky",
    "pretest:e2e": "tsx scripts/ensure-services.ts --test",
    "pretest:integration": "tsx scripts/ensure-services.ts --test",
    "release:pr": "tsx scripts/release-pr.ts",
    "release:version": "tsx scripts/release-version.ts",
    "review:findings": "tsx scripts/review-findings.ts",
    "setup": "tsx scripts/setup.ts",
    "start": "next start",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "test:e2e:browser": "playwright install --with-deps chromium",
    "test:integration": "tsx scripts/with-test-db.ts node node_modules/vitest/vitest.mjs run tests/integration",
    "test:shuffle": "vitest run tests/unit --sequence.shuffle",
    "test:unit": "vitest run tests/unit --coverage && tsx scripts/coverage-gaps.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:sentry": "tsx scripts/verify-sentry.ts"
  },
  "dependencies": {
    "@axiomhq/pino": "2.0.0",
    "@sentry/nextjs": "10.74.0",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "next": "16.3.5",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "25.9.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "drizzle-kit": "0.31.10",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.3": true,
    "@sentry/cli@2.58.6": true
  },
  "packageManager": "npm@12.0.2",
  "overrides": {
    "browserslist": "^4.28.7",
    "fast-uri": "^4.0.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
