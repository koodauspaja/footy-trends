{
  "name": "footy-trends",
  "private": true,
  "scripts": {
    "admin:role": "tsx scripts/grant-admin.ts",
    "backfill": "tsx scripts/backfill.ts",
    "build": "next build",
    "db:generate": "tsx scripts/generate-migration.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:reset:dev": "tsx scripts/db-reset.ts --dev",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbopack",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "predb:migrate": "tsx scripts/ensure-services.ts",
    "predb:push": "tsx scripts/ensure-services.ts",
    "predb:studio": "tsx scripts/ensure-services.ts",
    "predev": "tsx scripts/ensure-services.ts",
    "predictions": "tsx scripts/predictions.ts",
    "railway:environment": "tsx scripts/railway-environment.ts",
    "prepare": "husky",
    "pretest:e2e": "tsx scripts/ensure-services.ts --test",
    "pretest:integration": "tsx scripts/ensure-services.ts --test",
    "release:pr": "tsx scripts/release-pr.ts",
    "release:version": "tsx scripts/release-version.ts",
    "review:findings": "tsx scripts/review-findings.ts",
    "check:boxes": "tsx scripts/issue-boxes.ts",
    "check:sourcery": "tsx scripts/sourcery-review.ts",
    "setup": "tsx scripts/setup-main.ts",
    "start": "next start",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "test:e2e:browser": "playwright install --with-deps chromium",
    "test:integration": "tsx scripts/with-test-db.ts node node_modules/vitest/vitest.mjs run tests/integration",
    "test:shuffle": "vitest run tests/unit --sequence.shuffle",
    "test:unit": "vitest run tests/unit --coverage && tsx scripts/coverage-gaps.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:sentry": "tsx scripts/verify-sentry.ts",
    "verify": "tsx scripts/verify.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:record-taso": "tsx scripts/record-taso-fixture.ts",
    "pretest:e2e:ui": "tsx scripts/ensure-services.ts --test",
    "preux:screenshots": "tsx scripts/ensure-services.ts --test",
    "ux:screenshots": "E2E_TASO_STUB=1 playwright test --config playwright.ux.config.ts"
  },
  "dependencies": {
    "@axiomhq/pino": "2.0.0",
    "@sentry/nextjs": "11.10.0",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "next": "16.4.3",
    "pino": "10.4.0",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "railway": "3.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.3": true
  },
  "packageManager": "npm@12.2.1",
  "overrides": {
    "browserslist": "^4.28.7",
    "fast-uri": "^4.0.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
