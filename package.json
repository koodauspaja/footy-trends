{
  "name": "footy-trends",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:role": "tsx scripts/db/grant-admin.ts",
    "backfill": "tsx scripts/backfill/backfill.ts",
    "backup": "tsx scripts/backup/backup.ts",
    "backup:restore": "tsx scripts/backup/restore.ts",
    "build": "next build",
    "db:generate": "tsx scripts/db/generate-migration.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:reset": "tsx scripts/db/db-reset.ts",
    "db:reset:dev": "tsx scripts/db/db-reset.ts --dev",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbopack",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "predb:migrate": "tsx scripts/local/ensure-services.ts",
    "predb:push": "tsx scripts/local/ensure-services.ts",
    "predb:studio": "tsx scripts/local/ensure-services.ts",
    "predev": "tsx scripts/local/ensure-services.ts",
    "predictions": "tsx scripts/predictions/predictions.ts",
    "railway:environment": "tsx scripts/environments/railway-environment.ts",
    "prepare": "husky",
    "pretest:e2e": "tsx scripts/e2e/e2e-ports.ts && tsx scripts/local/ensure-services.ts --test",
    "pretest:integration": "tsx scripts/local/ensure-services.ts --test",
    "release:pr": "tsx scripts/release/release-pr.ts",
    "release:version": "tsx scripts/release/release-version.ts",
    "review:findings": "tsx scripts/checks/review-findings.ts",
    "check:boxes": "tsx scripts/checks/issue-boxes.ts",
    "check:commits": "tsx scripts/hooks/commit-subjects.ts",
    "check:sourcery": "tsx scripts/checks/sourcery-review.ts",
    "setup": "tsx scripts/local/setup-main.ts",
    "start": "next start",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "test:e2e:browser": "playwright install --with-deps chromium",
    "test:integration": "tsx scripts/db/with-test-db.ts node node_modules/vitest/vitest.mjs run tests/integration",
    "test:shuffle": "vitest run tests/unit --sequence.shuffle --reporter=default --reporter=./scripts/checks/console-output-reporter.ts",
    "test:unit": "vitest run tests/unit --coverage --reporter=default --reporter=./scripts/checks/console-output-reporter.ts && tsx scripts/checks/coverage-gaps.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:sentry": "tsx scripts/environments/verify-sentry.ts",
    "verify": "tsx scripts/checks/verify.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:record-taso": "tsx scripts/e2e/record-taso-fixture.ts",
    "pretest:e2e:ui": "tsx scripts/local/ensure-services.ts --test",
    "preux:screenshots": "tsx scripts/local/ensure-services.ts --test",
    "ux:screenshots": "E2E_TASO_STUB=1 playwright test --config playwright.ux.config.ts"
  },
  "dependencies": {
    "@axiomhq/pino": "2.0.0",
    "@sentry/nextjs": "11.12.0",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "next": "16.4.6",
    "pino": "10.4.0",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "railway": "3.17.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "packageManager": "npm@12.2.3",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
