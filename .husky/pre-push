# Why each setting is as it is: decisions/531-configuration-files.md
# Blocks a push that no passing e2e run covers: see tests/e2e/README.md.
# `git push --no-verify` skips it. Skipped quietly when dependencies are not
# installed.
if [ ! -x node_modules/.bin/tsx ]; then
  echo "e2e freshness check skipped: run npm install to enable it."
  exit 0
fi

node_modules/.bin/tsx scripts/e2e-freshness.ts
