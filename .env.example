# Why each setting is as it is: decisions/531-configuration-files.md
# Football data API
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_REFRESH_INTERVAL_SECONDS=3600

# Database. Railway injects DATABASE_URL in production; locally `npm run setup`
# writes it, together with the password below. By hand: see INSTALL.md.
DATABASE_URL=

# The local Postgres container's password, read by docker-compose.yml. Any value
# works as long as DATABASE_URL above carries the same one. Blank here on
# purpose: this file is tracked.
FOOTY_POSTGRES_PASSWORD=

# Redis — Railway injects REDIS_URL automatically in production
REDIS_URL=redis://localhost:6379

# Google OAuth, through better-auth. `npm run setup` generates
# BETTER_AUTH_SECRET and fills in BETTER_AUTH_URL. The Google pair is yours to
# add: only sign-in needs it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Which header carries the visitor's address, for per-client rate limiting.
# Blank means `x-real-ip`. Both are comma-separated; list only a header measured
# as one the platform overwrites.
AUTH_CLIENT_IP_HEADERS=
AUTH_TRUSTED_PROXIES=

# Who may sign in, comma-separated. Blank means no restriction, which is what
# production and local development want.
AUTH_ALLOWED_EMAILS=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
# Production overrides: see docs/setup/021-production-environment.md. Blank
# means the development defaults (100% tracing, PII on).
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_ENABLE_LOGS=
SENTRY_SEND_DEFAULT_PII=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_ENABLE_LOGS=
NEXT_PUBLIC_SENTRY_SEND_DEFAULT_PII=

# Axiom logging
AXIOM_TOKEN=
AXIOM_DATASET=footy-trends
LOG_LEVEL=info
# Earliest selectable season (start year). Bounded by the football-data.org API plan.
FOOTBALL_DATA_EARLIEST_SEASON=2023

# TASO API (spl.torneopal.net) — Veikkausliiga data.
# Scraped from tulospalvelu.palloliitto.fi's own network requests, not a registered
# credential — see docs/setup/ for the re-scrape procedure.
TASO_API_KEY=
