# Football data API
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_REFRESH_INTERVAL_SECONDS=3600

# Database — Railway injects DATABASE_URL automatically in production
DATABASE_URL=postgresql://user:password@localhost:5432/footy-trends

# Redis — Railway injects REDIS_URL automatically in production (added in 016)
REDIS_URL=redis://localhost:6379

# Google OAuth (added in 014)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Sentry (added in 017)
NEXT_PUBLIC_SENTRY_DSN=
# Production overrides — see docs/setup/021-production-environment.md.
# Unset — or left blank, as below — means the development defaults (100% tracing,
# PII on), which is what the Sentry wizard ships and what production must not
# inherit. Blank is treated as unset deliberately: `Number("")` is 0, so an empty
# sample rate would otherwise switch tracing off entirely while looking set.
# The NEXT_PUBLIC_ pair is separate because browser values are inlined at build
# time; a server-only variable reads as undefined there.
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_ENABLE_LOGS=
SENTRY_SEND_DEFAULT_PII=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_ENABLE_LOGS=
NEXT_PUBLIC_SENTRY_SEND_DEFAULT_PII=

# Axiom logging (added in 009)
AXIOM_TOKEN=
AXIOM_DATASET=footy-trends
LOG_LEVEL=info
# Earliest selectable season (start year). Bounded by the football-data.org API plan.
FOOTBALL_DATA_EARLIEST_SEASON=2023

# TASO API (spl.torneopal.net) — Veikkausliiga data, added in specs/009-veikkausliiga.md.
# Scraped from tulospalvelu.palloliitto.fi's own network requests, not a registered
# credential — see docs/setup/ for the re-scrape procedure.
TASO_API_KEY=
