node_modules/
dist/
.env
.env.local
*.log
.DS_Store
# Editor state is personal; the two files that describe *this project* are not.
# `settings.json` existed only on individual machines, ignored and so never
# reviewed — which is how it kept a `YOUR_PROJECT_KEY` placeholder, and SonarLint
# connected mode, for everyone who had it, resolved nothing (#400).
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
tsconfig.tsbuildinfo
# Sentry Config File
.env.sentry-build-plugin
.next/
coverage/
.claude/settings.local.json
playwright-report/
test-results/
blob-report/

# Written by the e2e freshness reporter, read by the pre-push hook (#84).
.e2e-freshness

# Generated by Next, and its contents depend on which command ran last:
# `next build` writes .next/types/, `next dev` writes .next/dev/types/. Tracking
# it means every switch between the two dirties the tree. tsconfig.json's
# `include` already lists both directories, so nothing here depends on it (#211).
next-env.d.ts
