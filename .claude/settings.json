{
  "permissions": {
    "allow": [
      "Bash(npx vitest *)",
      "Bash(gh api *)",
      "Bash(git commit -m ' *)",
      "Bash(python3 -c ' *)",
      "Bash(xargs -I{} echo {})"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/claude-bash-guard.sh\""
          }
        ]
      }
    ]
  }
}
